@page
@model EventManagement.Pages.Events.MyFeedbackModel
@{
    ViewData["Title"] = "Đánh giá của tôi";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="text-gold mb-4">
                <i class="fas fa-star me-2"></i>Đánh giá của tôi
            </h2>

            @if (Model.Feedbacks.Any())
            {
                <div class="row g-4">
                    @foreach (var feedback in Model.Feedbacks)
                    {
                        <div class="col-12">
                            <div class="card bg-dark border-gold">
                                <div class="card-body">
                                    <h5 class="text-gold mb-2">@feedback.Event.EventName</h5>
                                    <p class="text-muted mb-3">
                                        <i class="fas fa-calendar me-2"></i>@feedback.Event.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </p>
                                    <div class="mb-3">
                                        <div class="rating">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(feedback.Rating.HasValue && i <= feedback.Rating.Value ? "text-warning" : "text-muted")"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-white mb-2">@feedback.Comments</p>
                                    @if (!string.IsNullOrEmpty(feedback.Suggestions))
                                    {
                                        <p class="text-muted mb-0">
                                            <i class="fas fa-lightbulb me-2"></i>@feedback.Suggestions
                                        </p>
                                    }
                                    <div class="mt-3">
                                        <span class="badge bg-@(feedback.IsPublic ? "success" : "secondary")">
                                            @(feedback.IsPublic ? "Công khai" : "Riêng tư")
                                        </span>
                                        @if (feedback.WouldRecommend.HasValue && feedback.WouldRecommend.Value)
                                        {
                                            <span class="badge bg-info ms-2">
                                                <i class="fas fa-thumbs-up me-1"></i>Sẽ giới thiệu
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-star fa-4x text-muted mb-4"></i>
                    <h3 class="text-muted">Chưa có đánh giá nào</h3>
                    <p class="text-muted mb-4">Bạn chưa đánh giá sự kiện nào.</p>
                    <a href="/Events" class="btn btn-outline-gold">
                        <i class="fas fa-calendar-alt me-2"></i>Xem danh sách sự kiện
                    </a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark border-gold mb-4">
                <div class="card-body">
                    <h5 class="text-gold mb-4">Thống kê</h5>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Tổng số đánh giá:</span>
                        <span class="text-white">@Model.Feedbacks.Count</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Đánh giá công khai:</span>
                        <span class="text-white">@Model.Feedbacks.Count(f => f.IsPublic)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Đánh giá trung bình:</span>
                        <span class="text-white">@string.Format("{0:0.0}", Model.Feedbacks.Any() ? Model.Feedbacks.Where(f => f.Rating.HasValue).Average(f => f.Rating!.Value) : 0.0)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .rating {
            display: flex;
            gap: 5px;
        }

        .rating .fa-star {
            font-size: 20px;
        }
    </style>
} 