@page
@model EventManagement.Pages.Events.MyEventsModel
@{
    ViewData["Title"] = "Sự kiện của tôi";
}
<div class="container py-5">
    <h2 class="text-gold mb-4"><i class="fas fa-calendar-check me-2"></i>Sự kiện của tôi</h2>
    @if (Model.MyEvents.Count == 0)
    {
        <div class="alert alert-info">Bạn chưa tạo sự kiện nào.</div>
    }
    else
    {
        <div class="card bg-dark border-gold">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Tên sự kiện</th>
                                <th>Thời gian</th>
                                <th>Trạng thái</th>
                                <th>Số đăng ký</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var evt in Model.MyEvents)
                        {
                            <tr>
                                <td>@evt.EventName</td>
                                <td>@evt.StartDate.ToString("dd/MM/yyyy HH:mm") - @evt.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (evt.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Đã hủy</span>
                                    }
                                    else if (evt.Status == "Upcoming")
                                    {
                                        <span class="badge bg-info">Sắp diễn ra</span>
                                    }
                                    else if (evt.Status == "Ongoing")
                                    {
                                        <span class="badge bg-success">Đang diễn ra</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Đã kết thúc</span>
                                    }
                                </td>
                                <td>@evt.Registrations.Count</td>
                                <td>
                                    <a href="/Events/Details/@evt.EventId" class="btn btn-sm btn-outline-gold me-2">
                                        <i class="fas fa-eye me-1"></i>Xem
                                    </a>
                                    <a href="/Events/Edit/@evt.EventId" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-edit me-1"></i>Sửa
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div> 