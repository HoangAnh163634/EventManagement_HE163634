@page
@model EventManagement.Pages.Admin.TrashModel
@{
    ViewData["Title"] = "Thùng rác (Trash)";
    Layout = "../Shared/_Layout.cshtml";
}
<partial name="../Shared/Partials/_AdminSidebar" />
<div style="margin-left:240px;">
    <div class="container py-5">
        <h2 class="text-gold mb-4"><i class="fas fa-trash-alt me-2"></i>Thùng rác</h2>
        <div class="row">
            <div class="col-md-12 mb-4">
                <h4 class="text-warning">Sự kiện đã xóa</h4>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Tên sự kiện</th>
                                <th>Thời gian</th>
                                <th>Địa điểm</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in Model.DeletedEvents)
                            {
                                <tr>
                                    <td>@evt.EventName</td>
                                    <td>@evt.StartDate.ToString("dd/MM/yyyy") - @evt.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>@evt.Location</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success me-2" onclick="restoreEvent(@evt.EventId)"><i class="fas fa-undo"></i> Khôi phục</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteEvent(@evt.EventId)"><i class="fas fa-trash"></i> Xóa vĩnh viễn</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12 mb-4">
                <h4 class="text-warning">Người dùng đã xóa</h4>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Họ tên</th>
                                <th>Email</th>
                                <th>Ngày tạo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.DeletedUsers)
                            {
                                <tr>
                                    <td>@user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success me-2" onclick="restoreUser(@user.UserId)"><i class="fas fa-undo"></i> Khôi phục</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteUser(@user.UserId)"><i class="fas fa-trash"></i> Xóa vĩnh viễn</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-12 mb-4">
                <h4 class="text-warning">Đăng ký đã xóa</h4>
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Người đăng ký</th>
                                <th>Sự kiện</th>
                                <th>Ngày đăng ký</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.DeletedRegistrations)
                            {
                                <tr>
                                    <td>@reg.Attendee.FullName</td>
                                    <td>@reg.Event.EventName</td>
                                    <td>@reg.RegistrationDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success me-2" onclick="restoreRegistration(@reg.RegistrationId)"><i class="fas fa-undo"></i> Khôi phục</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteRegistration(@reg.RegistrationId)"><i class="fas fa-trash"></i> Xóa vĩnh viễn</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    function restoreEvent(eventId) {
        if (confirm('Khôi phục sự kiện này?')) {
            fetch('?handler=RestoreEvent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ eventId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
    function deleteEvent(eventId) {
        if (confirm('Xóa vĩnh viễn sự kiện này?')) {
            fetch('?handler=DeleteEvent', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ eventId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
    function restoreUser(userId) {
        if (confirm('Khôi phục người dùng này?')) {
            fetch('?handler=RestoreUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
    function deleteUser(userId) {
        if (confirm('Xóa vĩnh viễn người dùng này?')) {
            fetch('?handler=DeleteUser', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ userId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
    function restoreRegistration(registrationId) {
        if (confirm('Khôi phục đăng ký này?')) {
            fetch('?handler=RestoreRegistration', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ registrationId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
    function deleteRegistration(registrationId) {
        if (confirm('Xóa vĩnh viễn đăng ký này?')) {
            fetch('?handler=DeleteRegistration', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ registrationId })
            })
            .then(response => response.json())
            .then(data => { if (data.success) location.reload(); else alert(data.message); });
        }
    }
</script>
} 