@page "{id:int}"
@model EventManagement.Pages.Admin.RegistrationDetailsModel
@{
    ViewData["Title"] = "Chi tiết đăng ký";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card bg-dark text-white">
                <div class="card-header bg-gold text-dark d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">
                        <i class="fas fa-clipboard-list me-2"></i>Chi tiết đăng ký
                    </h4>
                    <a href="/Admin/Registrations" class="btn btn-dark">
                        <i class="fas fa-arrow-left me-2"></i>Quay lại
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Registration != null)
                    {
                        <div class="row mb-4">
                            <div class="col-md-12">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div>
                                        <h3>@Model.Registration.Event.EventName</h3>
                                        <div class="text-muted">
                                            <i class="fas fa-calendar me-2"></i>@Model.Registration.Event.StartDate.ToString("dd/MM/yyyy HH:mm") - @Model.Registration.Event.EndDate.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                        <div class="text-muted">
                                            <i class="fas fa-map-marker-alt me-2"></i>@Model.Registration.Event.Location
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @switch (Model.Registration.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning mb-2">Chờ duyệt</span>
                                                break;
                                            case "Confirmed":
                                                <span class="badge bg-success mb-2">Đã duyệt</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger mb-2">Đã hủy</span>
                                                break;
                                            case "CheckedIn":
                                                <span class="badge bg-info mb-2">Đã check-in</span>
                                                break;
                                        }
                                        <div class="text-muted small">
                                            Đăng ký lúc: @Model.Registration.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-3 mb-4">
                                    <div class="col-md-6">
                                        <div class="card bg-dark border-secondary h-100">
                                            <div class="card-body">
                                                <h6 class="card-title">
                                                    <i class="fas fa-user me-2"></i>Thông tin người đăng ký
                                                </h6>
                                                <div>
                                                    <a href="/Admin/UserDetails/@Model.Registration.AttendeeId" class="text-gold">
                                                        @Model.Registration.Attendee.FullName
                                                    </a>
                                                </div>
                                                <div class="text-muted">@Model.Registration.Attendee.Email</div>
                                                <div class="text-muted">@Model.Registration.Attendee.PhoneNumber</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card bg-dark border-secondary h-100">
                                            <div class="card-body">
                                                <h6 class="card-title">
                                                    <i class="fas fa-clipboard-check me-2"></i>Thông tin check-in
                                                </h6>
                                                @if (Model.Registration.CheckInTime.HasValue)
                                                {
                                                    <div>Thời gian: @Model.Registration.CheckInTime.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                                    <div>Phương thức: @Model.Registration.CheckInMethod</div>
                                                    <div>Địa điểm: @Model.Registration.CheckInLocation</div>
                                                    <div>
                                                        Người xác nhận:
                                                        <a href="/Admin/UserDetails/@Model.Registration.CheckInBy" class="text-gold">
                                                            @Model.Registration.CheckInByNavigation?.FullName
                                                        </a>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="text-muted">Chưa check-in</div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Registration.SpecialRequests))
                                {
                                    <div class="card bg-dark border-secondary mb-4">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-comment-alt me-2"></i>Yêu cầu đặc biệt
                                            </h6>
                                            <p class="mb-0">@Model.Registration.SpecialRequests</p>
                                        </div>
                                    </div>
                                }

                                @if (Model.Registration.Status == "Cancelled")
                                {
                                    <div class="card bg-dark border-secondary mb-4">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-ban me-2"></i>Lý do hủy
                                            </h6>
                                            <p class="mb-0">@Model.Registration.CancellationReason</p>
                                        </div>
                                    </div>
                                }

                                @if (Model.Registration.Feedback != null)
                                {
                                    <div class="card bg-dark border-secondary mb-4">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-star me-2"></i>Đánh giá
                                            </h6>
                                            <div class="mb-2">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    <i class="fas fa-star @(i <= Model.Registration.Feedback.Rating ? "text-warning" : "text-secondary")"></i>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(Model.Registration.Feedback.Comments))
                                            {
                                                <p class="mb-2">@Model.Registration.Feedback.Comments</p>
                                            }
                                            @if (!string.IsNullOrEmpty(Model.Registration.Feedback.Suggestions))
                                            {
                                                <p class="mb-0 text-muted">
                                                    <i class="fas fa-lightbulb me-2"></i>@Model.Registration.Feedback.Suggestions
                                                </p>
                                            }
                                            <div class="mt-2">
                                                <span class="badge @(Model.Registration.Feedback.WouldRecommend == true ? "bg-success" : "bg-danger")">
                                                    <i class="fas @(Model.Registration.Feedback.WouldRecommend == true ? "fa-thumbs-up" : "fa-thumbs-down") me-1"></i>
                                                    @(Model.Registration.Feedback.WouldRecommend == true ? "Sẽ giới thiệu" : "Không giới thiệu")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (Model.Registration.Qrcode != null)
                                {
                                    <div class="card bg-dark border-secondary mb-4">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-qrcode me-2"></i>QR Code
                                            </h6>
                                            <div class="text-center">
                                                <img src="@Model.Registration.Qrcode.QrcodeImageUrl" class="img-fluid" alt="QR Code">
                                            </div>
                                            <div class="text-muted text-center mt-2">
                                                <small>Số lần quét: @Model.Registration.Qrcode.ScanCount</small>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <div class="d-flex gap-2">
                                    @if (Model.Registration.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-success"
                                                onclick="updateStatus(@Model.Registration.RegistrationId, 'Confirmed')">
                                            <i class="fas fa-check me-2"></i>Duyệt đăng ký
                                        </button>
                                    }
                                    @if (Model.Registration.Status == "Confirmed" && !Model.Registration.CheckInTime.HasValue)
                                    {
                                        <button type="button" class="btn btn-info"
                                                onclick="checkIn(@Model.Registration.RegistrationId)">
                                            <i class="fas fa-sign-in-alt me-2"></i>Check-in
                                        </button>
                                    }
                                    @if (Model.Registration.Status != "Cancelled" && Model.Registration.Status != "CheckedIn")
                                    {
                                        <button type="button" class="btn btn-danger"
                                                onclick="updateStatus(@Model.Registration.RegistrationId, 'Cancelled')">
                                            <i class="fas fa-ban me-2"></i>Hủy đăng ký
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                            <h5>Không tìm thấy đăng ký</h5>
                            <a href="/Admin/Registrations" class="btn btn-outline-secondary mt-3">
                                <i class="fas fa-arrow-left me-2"></i>Quay lại
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Check-in Modal -->
<div class="modal fade" id="checkInModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content bg-dark text-white">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Check-in đăng ký</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="registrationId">
                <div class="mb-3">
                    <label class="form-label">Phương thức check-in</label>
                    <select id="checkInMethod" class="form-select bg-dark text-white border-secondary">
                        <option value="Manual">Thủ công</option>
                        <option value="QRCode">QR Code</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Địa điểm check-in</label>
                    <input type="text" id="checkInLocation" class="form-control bg-dark text-white border-secondary">
                </div>
            </div>
            <div class="modal-footer border-secondary">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-info" onclick="submitCheckIn()">
                    <i class="fas fa-sign-in-alt me-2"></i>Check-in
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let checkInModal;
        
        document.addEventListener('DOMContentLoaded', function() {
            checkInModal = new bootstrap.Modal(document.getElementById('checkInModal'));
        });

        function updateStatus(registrationId, status) {
            const action = status === 'Confirmed' ? 'duyệt' : 'hủy';
            if (confirm(`Bạn có chắc chắn muốn ${action} đăng ký này?`)) {
                fetch(`/Admin/Registrations?handler=UpdateStatus`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ registrationId, status })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }

        function checkIn(registrationId) {
            document.getElementById('registrationId').value = registrationId;
            document.getElementById('checkInMethod').value = 'Manual';
            document.getElementById('checkInLocation').value = '';
            checkInModal.show();
        }

        function submitCheckIn() {
            const registrationId = document.getElementById('registrationId').value;
            const checkInMethod = document.getElementById('checkInMethod').value;
            const checkInLocation = document.getElementById('checkInLocation').value;

            if (!checkInLocation) {
                alert('Vui lòng nhập địa điểm check-in.');
                return;
            }

            fetch(`/Admin/Registrations?handler=CheckIn`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ registrationId, checkInMethod, checkInLocation })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    checkInModal.hide();
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                }
            });
        }
    </script>
} 