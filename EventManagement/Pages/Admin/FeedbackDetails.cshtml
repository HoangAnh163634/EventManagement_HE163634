@page "{id:int}"
@model EventManagement.Pages.Admin.FeedbackDetailsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
<div style="margin-left:240px;">
    @{
        ViewData["Title"] = "Chi tiết feedback";
    }

    <div class="container py-5">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card bg-dark text-white">
                    <div class="card-header bg-gold text-dark d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-comments me-2"></i>Chi tiết feedback
                        </h4>
                        <a href="/Admin/Feedbacks" class="btn btn-dark">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                    <div class="card-body">
                        @if (Model.Feedback != null)
                        {
                            <div class="row mb-4">
                                <div class="col-md-12">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <div>
                                            <h3>@Model.Feedback.Event.EventName</h3>
                                            <div class="text-muted">
                                                <i class="fas fa-calendar me-2"></i>@Model.Feedback.Event.StartDate.ToString("dd/MM/yyyy HH:mm") - @Model.Feedback.Event.EndDate.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                            <div class="text-muted">
                                                <i class="fas fa-map-marker-alt me-2"></i>@Model.Feedback.Event.Location
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <div class="mb-2">
                                                @if (Model.Feedback.IsApproved)
                                                {
                                                    <span class="badge bg-success">Đã duyệt</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Chờ duyệt</span>
                                                }
                                            </div>
                                            <div>
                                                @if (Model.Feedback.IsPublic)
                                                {
                                                    <span class="badge bg-info">Công khai</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Riêng tư</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-user me-2"></i>Thông tin người đánh giá
                                                    </h6>
                                                    <div>
                                                        <a href="/Admin/UserDetails/@Model.Feedback.AttendeeId" class="text-gold">
                                                            @Model.Feedback.Attendee.FullName
                                                        </a>
                                                    </div>
                                                    <div class="text-muted">@Model.Feedback.Attendee.Email</div>
                                                    <div class="text-muted">@Model.Feedback.Attendee.PhoneNumber</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-star me-2"></i>Đánh giá
                                                    </h6>
                                                    <div class="mb-2">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            <i class="fas fa-star @(i <= Model.Feedback.Rating ? "text-warning" : "text-secondary")"></i>
                                                        }
                                                    </div>
                                                    <div>
                                                        <span class="badge @(Model.Feedback.WouldRecommend == true ? "bg-success" : "bg-danger")">
                                                            <i class="fas @(Model.Feedback.WouldRecommend == true ? "fa-thumbs-up" : "fa-thumbs-down") me-1"></i>
                                                            @(Model.Feedback.WouldRecommend == true ? "Sẽ giới thiệu" : "Không giới thiệu")
                                                        </span>
                                                    </div>
                                                    <div class="text-muted mt-2">
                                                        <i class="fas fa-clock me-1"></i>@Model.Feedback.SubmittedAt.ToString("dd/MM/yyyy HH:mm")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.Feedback.Comments))
                                    {
                                        <div class="card bg-dark border-secondary mb-4">
                                            <div class="card-body">
                                                <h6 class="card-title">
                                                    <i class="fas fa-comment me-2"></i>Nhận xét
                                                </h6>
                                                <p class="mb-0">@Model.Feedback.Comments</p>
                                            </div>
                                        </div>
                                    }

                                    @if (!string.IsNullOrEmpty(Model.Feedback.Suggestions))
                                    {
                                        <div class="card bg-dark border-secondary mb-4">
                                            <div class="card-body">
                                                <h6 class="card-title">
                                                    <i class="fas fa-lightbulb me-2"></i>Góp ý
                                                </h6>
                                                <p class="mb-0">@Model.Feedback.Suggestions</p>
                                            </div>
                                        </div>
                                    }

                                    <div class="d-flex gap-2">
                                        @if (!Model.Feedback.IsApproved)
                                        {
                                            <button type="button" class="btn btn-success"
                                                    onclick="updateStatus(@Model.Feedback.FeedbackId, true, @Model.Feedback.IsPublic.ToString().ToLower())">
                                                <i class="fas fa-check me-2"></i>Duyệt feedback
                                            </button>
                                        }
                                        <button type="button" class="btn @(Model.Feedback.IsPublic ? "btn-secondary" : "btn-info")"
                                                onclick="updateStatus(@Model.Feedback.FeedbackId, @Model.Feedback.IsApproved.ToString().ToLower(), !@Model.Feedback.IsPublic.ToString().ToLower())">
                                            <i class="fas @(Model.Feedback.IsPublic ? "fa-eye-slash" : "fa-eye") me-2"></i>
                                            @(Model.Feedback.IsPublic ? "Ẩn feedback" : "Hiện feedback")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                                <h5>Không tìm thấy feedback</h5>
                                <a href="/Admin/Feedbacks" class="btn btn-outline-secondary mt-3">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateStatus(feedbackId, isApproved, isPublic) {
            const action = !isApproved ? 'duyệt' : (isPublic ? 'ẩn' : 'hiện');
            if (confirm(`Bạn có chắc chắn muốn ${action} feedback này?`)) {
                fetch(`/Admin/Feedbacks?handler=UpdateStatus`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ feedbackId, isApproved, isPublic })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
} 