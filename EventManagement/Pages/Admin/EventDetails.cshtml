@page "{id:int}"
@model EventManagement.Pages.Admin.EventDetailsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
<div style="margin-left:240px;">
    @{
        ViewData["Title"] = "Chi tiết sự kiện";
    }

    <div class="container py-5">
        <div class="row">
            <div class="col-md-8 mx-auto">
                <div class="card bg-dark text-white">
                    <div class="card-header bg-gold text-dark d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-calendar-alt me-2"></i>Chi tiết sự kiện
                        </h4>
                        <a href="/Admin/Events" class="btn btn-dark">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                    <div class="card-body">
                        @if (Model.Event != null)
                        {
                            <div class="row mb-4">
                                <div class="col-md-8">
                                    <h3>@Model.Event.EventName</h3>
                                    <div class="d-flex align-items-center mb-3">
                                        <span class="badge me-2" style="background-color: @Model.Event.EventType.ColorCode">
                                            <i class="@Model.Event.EventType.IconClass me-1"></i>@Model.Event.EventType.EventTypeName
                                        </span>
                                        @{
                                            var now = DateTime.Now;
                                            var status = "";
                                            var statusClass = "";
                                            
                                            if (Model.Event.Status == "Cancelled")
                                            {
                                                status = "Đã hủy";
                                                statusClass = "bg-danger";
                                            }
                                            else if (now < Model.Event.StartDate)
                                            {
                                                status = "Sắp diễn ra";
                                                statusClass = "bg-info";
                                            }
                                            else if (now >= Model.Event.StartDate && now <= Model.Event.EndDate)
                                            {
                                                status = "Đang diễn ra";
                                                statusClass = "bg-success";
                                            }
                                            else
                                            {
                                                status = "Đã kết thúc";
                                                statusClass = "bg-secondary";
                                            }
                                        }
                                        <span class="badge @statusClass">@status</span>
                                    </div>
                                    <p class="text-muted mb-4">@Model.Event.Description</p>
                                    
                                    <div class="row g-3 mb-4">
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-clock me-2"></i>Thời gian
                                                    </h6>
                                                    <div>Bắt đầu: @Model.Event.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                    <div>Kết thúc: @Model.Event.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-map-marker-alt me-2"></i>Địa điểm
                                                    </h6>
                                                    <div>@Model.Event.Location</div>
                                                    @if (!string.IsNullOrEmpty(Model.Event.Address))
                                                    {
                                                        <div class="text-muted">@Model.Event.Address</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-user me-2"></i>Người tổ chức
                                                    </h6>
                                                    <div>
                                                        <a href="/Admin/UserDetails/@Model.Event.OrganizerId" class="text-gold">
                                                            @Model.Event.Organizer.FullName
                                                        </a>
                                                    </div>
                                                    <div class="text-muted">@Model.Event.Organizer.Email</div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card bg-dark border-secondary h-100">
                                                <div class="card-body">
                                                    <h6 class="card-title">
                                                        <i class="fas fa-users me-2"></i>Số lượng
                                                    </h6>
                                                    <div>@Model.Event.Registrations.Count/@Model.Event.MaxAttendees người</div>
                                                    <div class="progress bg-secondary mt-2" style="height: 5px;">
                                                        <div class="progress-bar bg-gold" role="progressbar" 
                                                             style="width: @(Model.Event.MaxAttendees > 0 ? (Model.Event.Registrations.Count * 100 / Model.Event.MaxAttendees) : 0)%">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    @if (Model.Event.Status != "Cancelled" && now < Model.Event.EndDate)
                                    {
                                        <button type="button" class="btn btn-danger" onclick="cancelEvent(@Model.Event.EventId)">
                                            <i class="fas fa-ban me-2"></i>Hủy sự kiện
                                        </button>
                                    }
                                </div>
                                <div class="col-md-4">
                                    @if (!string.IsNullOrEmpty(Model.Event.BannerImageUrl))
                                    {
                                        <img src="@Model.Event.BannerImageUrl" class="img-fluid rounded mb-3" alt="Banner">
                                    }
                                </div>
                            </div>

                            <div class="card bg-dark border-secondary mb-4">
                                <div class="card-header">
                                    <h5 class="mb-0">
                                        <i class="fas fa-clipboard-list me-2"></i>Danh sách đăng ký (@Model.Event.Registrations.Count)
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-dark table-hover align-middle">
                                            <thead>
                                                <tr>
                                                    <th>Họ tên</th>
                                                    <th>Email</th>
                                                    <th>Thời gian</th>
                                                    <th>Trạng thái</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var reg in Model.Event.Registrations.OrderByDescending(r => r.CreatedAt))
                                                {
                                                    <tr>
                                                        <td>
                                                            <a href="/Admin/UserDetails/@reg.AttendeeId" class="text-gold">
                                                                @reg.Attendee.FullName
                                                            </a>
                                                        </td>
                                                        <td>@reg.Attendee.Email</td>
                                                        <td>@reg.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                                        <td>
                                                            @switch (reg.Status)
                                                            {
                                                                case "Pending":
                                                                    <span class="badge bg-warning">Chờ duyệt</span>
                                                                    break;
                                                                case "Confirmed":
                                                                    <span class="badge bg-success">Đã duyệt</span>
                                                                    break;
                                                                case "Cancelled":
                                                                    <span class="badge bg-danger">Đã hủy</span>
                                                                    break;
                                                                case "CheckedIn":
                                                                    <span class="badge bg-info">Đã check-in</span>
                                                                    break;
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i>
                                <h5>Không tìm thấy sự kiện</h5>
                                <a href="/Admin/Events" class="btn btn-outline-secondary mt-3">
                                    <i class="fas fa-arrow-left me-2"></i>Quay lại
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelEvent(eventId) {
            if (confirm('Bạn có chắc chắn muốn hủy sự kiện này?')) {
                fetch(`/Admin/Events?handler=CancelEvent&eventId=${eventId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
} 