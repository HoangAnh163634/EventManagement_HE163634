@page
@model EventManagement.Pages.Admin.FeedbacksModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
<div style="margin-left:240px;">
    @{
        ViewData["Title"] = "Quản lý feedback";
    }

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-gold mb-0">
                <i class="fas fa-comments me-2"></i>Quản lý feedback
            </h2>
        </div>

        <!-- Search and Filter -->
        <div class="card bg-dark border-gold mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary">
                                <i class="fas fa-search text-gold"></i>
                            </span>
                            <input type="text" name="searchTerm" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Tìm kiếm nội dung..." value="@Model.SearchTerm">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="eventId" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả sự kiện</option>
                            @foreach (var evt in Model.Events)
                            {
                                <option value="@evt.EventId" selected="@(Model.EventId == evt.EventId)">
                                    @evt.EventName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="rating" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả đánh giá</option>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <option value="@i" selected="@(Model.Rating == i)">@i sao</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="isApproved" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả trạng thái</option>
                            <option value="true" selected="@(Model.IsApproved == true)">Đã duyệt</option>
                            <option value="false" selected="@(Model.IsApproved == false)">Chưa duyệt</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="isPublic" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả hiển thị</option>
                            <option value="true" selected="@(Model.IsPublic == true)">Công khai</option>
                            <option value="false" selected="@(Model.IsPublic == false)">Riêng tư</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-gold w-100">
                            <i class="fas fa-filter"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Feedbacks Table -->
        <div class="card bg-dark border-gold">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@Model.GetSortUrl("event")" class="text-white text-decoration-none">
                                        Sự kiện
                                        @if (Model.SortBy == "event")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl("attendee")" class="text-white text-decoration-none">
                                        Người đánh giá
                                        @if (Model.SortBy == "attendee")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl("rating")" class="text-white text-decoration-none">
                                        Đánh giá
                                        @if (Model.SortBy == "rating")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>Nội dung</th>
                                <th>
                                    <a href="@Model.GetSortUrl("date")" class="text-white text-decoration-none">
                                        Thời gian
                                        @if (Model.SortBy == "date")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>Trạng thái</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var feedback in Model.Feedbacks)
                            {
                                <tr>
                                    <td>
                                        <a href="/Admin/Events/@feedback.EventId" class="text-gold">
                                            @feedback.Event.EventName
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/Admin/UserDetails/@feedback.AttendeeId" class="text-gold">
                                            @feedback.Attendee.FullName
                                        </a>
                                        <div class="text-muted small">@feedback.Attendee.Email</div>
                                    </td>
                                    <td>
                                        <div class="mb-1">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="fas fa-star @(i <= feedback.Rating ? "text-warning" : "text-secondary")"></i>
                                            }
                                        </div>
                                        <span class="badge @(feedback.WouldRecommend == true ? "bg-success" : "bg-danger")">
                                            <i class="fas @(feedback.WouldRecommend == true ? "fa-thumbs-up" : "fa-thumbs-down") me-1"></i>
                                            @(feedback.WouldRecommend == true ? "Sẽ giới thiệu" : "Không giới thiệu")
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(feedback.Comments))
                                        {
                                            <div>@feedback.Comments</div>
                                        }
                                        @if (!string.IsNullOrEmpty(feedback.Suggestions))
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-lightbulb me-1"></i>@feedback.Suggestions
                                            </div>
                                        }
                                    </td>
                                    <td>@feedback.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="mb-1">
                                            @if (feedback.IsApproved)
                                            {
                                                <span class="badge bg-success">Đã duyệt</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Chờ duyệt</span>
                                            }
                                        </div>
                                        <div>
                                            @if (feedback.IsPublic)
                                            {
                                                <span class="badge bg-info">Công khai</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Riêng tư</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/FeedbackDetails/@feedback.FeedbackId" class="btn btn-sm btn-outline-gold me-2">
                                            <i class="fas fa-eye me-1"></i>Chi tiết
                                        </a>
                                        @if (!feedback.IsApproved)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success me-2"
                                                    onclick="updateStatus(@feedback.FeedbackId, true, feedback.IsPublic)">
                                                <i class="fas fa-check me-1"></i>Duyệt
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm @(feedback.IsPublic ? "btn-outline-secondary" : "btn-outline-info")"
                                                onclick="updateStatus(@feedback.FeedbackId, feedback.IsApproved, !feedback.IsPublic)">
                                            <i class="fas @(feedback.IsPublic ? "fa-eye-slash" : "fa-eye") me-1"></i>
                                            @(feedback.IsPublic ? "Ẩn" : "Hiện")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Hiển thị @(((Model.CurrentPage - 1) * Model.PageSize) + 1) - @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) 
                            trên tổng số @Model.TotalItems feedback
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(i)">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateStatus(feedbackId, isApproved, isPublic) {
            const action = !isApproved ? 'duyệt' : (isPublic ? 'ẩn' : 'hiện');
            if (confirm(`Bạn có chắc chắn muốn ${action} feedback này?`)) {
                fetch(`/Admin/Feedbacks?handler=UpdateStatus`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ feedbackId, isApproved, isPublic })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
} 