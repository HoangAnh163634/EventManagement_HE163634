@page
@model EventManagement.Pages.Admin.EventsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
<div style="margin-left:240px;">
    @{
        ViewData["Title"] = "Quản lý sự kiện";
    }

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-gold mb-0">
                <i class="fas fa-calendar-alt me-2"></i>Quản lý sự kiện
            </h2>
        </div>

        <!-- Search and Filter -->
        <div class="card bg-dark border-gold mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary">
                                <i class="fas fa-search text-gold"></i>
                            </span>
                            <input type="text" name="searchTerm" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Tìm kiếm tên, mô tả..." value="@Model.SearchTerm">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="eventTypeId" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả loại</option>
                            @foreach (var type in Model.EventTypes)
                            {
                                <option value="@type.EventTypeId" selected="@(Model.EventTypeId == type.EventTypeId)">
                                    @type.EventTypeName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả trạng thái</option>
                            <option value="upcoming" selected="@(Model.Status == "upcoming")">Sắp diễn ra</option>
                            <option value="ongoing" selected="@(Model.Status == "ongoing")">Đang diễn ra</option>
                            <option value="completed" selected="@(Model.Status == "completed")">Đã kết thúc</option>
                            <option value="cancelled" selected="@(Model.Status == "cancelled")">Đã hủy</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="startDate" class="form-control bg-dark text-white border-secondary"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="endDate" class="form-control bg-dark text-white border-secondary"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-gold w-100">
                            <i class="fas fa-filter"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Events Table -->
        <div class="card bg-dark border-gold">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@Model.GetSortUrl("name")" class="text-white text-decoration-none">
                                        Tên sự kiện
                                        @if (Model.SortBy == "name")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>Loại</th>
                                <th>Người tổ chức</th>
                                <th>
                                    <a href="@Model.GetSortUrl("date")" class="text-white text-decoration-none">
                                        Thời gian
                                        @if (Model.SortBy == "date")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>Trạng thái</th>
                                <th>Số lượng</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in Model.Events)
                            {
                                <tr>
                                    <td>@evt.EventName</td>
                                    <td>
                                        <span class="badge" style="background-color: @evt.EventType.ColorCode">
                                            <i class="@evt.EventType.IconClass me-1"></i>@evt.EventType.EventTypeName
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/Admin/UserDetails/@evt.OrganizerId" class="text-gold">
                                            @evt.Organizer.FullName
                                        </a>
                                    </td>
                                    <td>
                                        <div>@evt.StartDate.ToString("dd/MM/yyyy HH:mm")</div>
                                        <small class="text-muted">đến</small>
                                        <div>@evt.EndDate.ToString("dd/MM/yyyy HH:mm")</div>
                                    </td>
                                    <td>
                                        @{
                                            var now = DateTime.Now;
                                            var status = "";
                                            var statusClass = "";
                                            
                                            if (evt.Status == "Cancelled")
                                            {
                                                status = "Đã hủy";
                                                statusClass = "bg-danger";
                                            }
                                            else if (now < evt.StartDate)
                                            {
                                                status = "Sắp diễn ra";
                                                statusClass = "bg-info";
                                            }
                                            else if (now >= evt.StartDate && now <= evt.EndDate)
                                            {
                                                status = "Đang diễn ra";
                                                statusClass = "bg-success";
                                            }
                                            else
                                            {
                                                status = "Đã kết thúc";
                                                statusClass = "bg-secondary";
                                            }
                                        }
                                        <span class="badge @statusClass">@status</span>
                                    </td>
                                    <td>
                                        <div>@evt.Registrations.Count/@evt.MaxAttendees</div>
                                        <div class="progress bg-secondary" style="height: 5px;">
                                            <div class="progress-bar bg-gold" role="progressbar" 
                                                 style="width: @(evt.MaxAttendees > 0 ? (evt.Registrations.Count * 100 / evt.MaxAttendees) : 0)%">
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <a href="/Admin/Events/@evt.EventId" class="btn btn-sm btn-outline-gold me-2">
                                            <i class="fas fa-eye me-1"></i>Chi tiết
                                        </a>
                                        @if (evt.Status != "Cancelled" && now < evt.EndDate)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="cancelEvent(@evt.EventId)">
                                                <i class="fas fa-ban me-1"></i>Hủy
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Hiển thị @(((Model.CurrentPage - 1) * Model.PageSize) + 1) - @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) 
                            trên tổng số @Model.TotalItems sự kiện
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(i)">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cancelEvent(eventId) {
            if (confirm('Bạn có chắc chắn muốn hủy sự kiện này?')) {
                fetch(`/Admin/Events?handler=CancelEvent&eventId=${eventId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }
    </script>
} 