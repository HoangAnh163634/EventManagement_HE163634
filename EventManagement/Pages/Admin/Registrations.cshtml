@page
@model EventManagement.Pages.Admin.RegistrationsModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}
<partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
<div style="margin-left:240px;">
    @{
        ViewData["Title"] = "Quản lý đăng ký";
    }

    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="text-gold mb-0">
                <i class="fas fa-clipboard-list me-2"></i>Quản lý đăng ký
            </h2>
        </div>

        <!-- Search and Filter -->
        <div class="card bg-dark border-gold mb-4">
            <div class="card-body">
                <form method="get" class="row g-3">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-dark border-secondary">
                                <i class="fas fa-search text-gold"></i>
                            </span>
                            <input type="text" name="searchTerm" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Tìm kiếm người đăng ký..." value="@Model.SearchTerm">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="eventId" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả sự kiện</option>
                            @foreach (var evt in Model.Events)
                            {
                                <option value="@evt.EventId" selected="@(Model.EventId == evt.EventId)">
                                    @evt.EventName
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select bg-dark text-white border-secondary">
                            <option value="">Tất cả trạng thái</option>
                            <option value="Pending" selected="@(Model.Status == "Pending")">Chờ duyệt</option>
                            <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Đã duyệt</option>
                            <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Đã hủy</option>
                            <option value="CheckedIn" selected="@(Model.Status == "CheckedIn")">Đã check-in</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="startDate" class="form-control bg-dark text-white border-secondary"
                               value="@(Model.StartDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="endDate" class="form-control bg-dark text-white border-secondary"
                               value="@(Model.EndDate?.ToString("yyyy-MM-dd"))">
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-gold w-100">
                            <i class="fas fa-filter"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Registrations Table -->
        <div class="card bg-dark border-gold">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@Model.GetSortUrl("attendee")" class="text-white text-decoration-none">
                                        Người đăng ký
                                        @if (Model.SortBy == "attendee")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl("event")" class="text-white text-decoration-none">
                                        Sự kiện
                                        @if (Model.SortBy == "event")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl("date")" class="text-white text-decoration-none">
                                        Ngày đăng ký
                                        @if (Model.SortBy == "date")
                                        {
                                            <i class="fas fa-sort-@(Model.SortOrder == "asc" ? "up" : "down") ms-1"></i>
                                        }
                                    </a>
                                </th>
                                <th>Trạng thái</th>
                                <th>Check-in</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reg in Model.Registrations)
                            {
                                <tr>
                                    <td>
                                        <a href="/Admin/UserDetails/@reg.AttendeeId" class="text-gold">
                                            @reg.Attendee.FullName
                                        </a>
                                        <div class="text-muted small">@reg.Attendee.Email</div>
                                    </td>
                                    <td>
                                        <a href="/Admin/Events/@reg.EventId" class="text-gold">
                                            @reg.Event.EventName
                                        </a>
                                        <div class="text-muted small">
                                            @reg.Event.StartDate.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>@reg.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @switch (reg.Status)
                                        {
                                            case "Pending":
                                                <span class="badge bg-warning">Chờ duyệt</span>
                                                break;
                                            case "Confirmed":
                                                <span class="badge bg-success">Đã duyệt</span>
                                                break;
                                            case "Cancelled":
                                                <span class="badge bg-danger">Đã hủy</span>
                                                break;
                                            case "CheckedIn":
                                                <span class="badge bg-info">Đã check-in</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (reg.CheckInTime.HasValue)
                                        {
                                            <div>@reg.CheckInTime.Value.ToString("dd/MM/yyyy HH:mm")</div>
                                            <div class="text-muted small">
                                                <i class="fas fa-map-marker-alt me-1"></i>@reg.CheckInLocation
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa check-in</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="/Admin/Registrations/@reg.RegistrationId" class="btn btn-sm btn-outline-gold me-2">
                                            <i class="fas fa-eye me-1"></i>Chi tiết
                                        </a>
                                        @if (reg.Status == "Pending")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-success me-2"
                                                    onclick="updateStatus(@reg.RegistrationId, 'Confirmed')">
                                                <i class="fas fa-check me-1"></i>Duyệt
                                            </button>
                                        }
                                        @if (reg.Status == "Confirmed" && !reg.CheckInTime.HasValue)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-info me-2"
                                                    onclick="checkIn(@reg.RegistrationId)">
                                                <i class="fas fa-sign-in-alt me-1"></i>Check-in
                                            </button>
                                        }
                                        @if (reg.Status != "Cancelled" && reg.Status != "CheckedIn")
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    onclick="updateStatus(@reg.RegistrationId, 'Cancelled')">
                                                <i class="fas fa-ban me-1"></i>Hủy
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <div class="text-muted">
                            Hiển thị @(((Model.CurrentPage - 1) * Model.PageSize) + 1) - @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) 
                            trên tổng số @Model.TotalItems đăng ký
                        </div>
                        <nav>
                            <ul class="pagination mb-0">
                                @if (Model.CurrentPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage - 1)">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    </li>
                                }

                                @for (int i = Math.Max(1, Model.CurrentPage - 2); i <= Math.Min(Model.TotalPages, Model.CurrentPage + 2); i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(i)">@i</a>
                                    </li>
                                }

                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    <li class="page-item">
                                        <a class="page-link bg-dark text-gold border-gold" 
                                           href="@Model.GetPageUrl(Model.CurrentPage + 1)">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Check-in Modal -->
    <div class="modal fade" id="checkInModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content bg-dark text-white">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title">Check-in đăng ký</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="registrationId">
                    <div class="mb-3">
                        <label class="form-label">Phương thức check-in</label>
                        <select id="checkInMethod" class="form-select bg-dark text-white border-secondary">
                            <option value="Manual">Thủ công</option>
                            <option value="QRCode">QR Code</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa điểm check-in</label>
                        <input type="text" id="checkInLocation" class="form-control bg-dark text-white border-secondary">
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-info" onclick="submitCheckIn()">
                        <i class="fas fa-sign-in-alt me-2"></i>Check-in
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let checkInModal;
        
        document.addEventListener('DOMContentLoaded', function() {
            checkInModal = new bootstrap.Modal(document.getElementById('checkInModal'));
        });

        function updateStatus(registrationId, status) {
            const action = status === 'Confirmed' ? 'duyệt' : 'hủy';
            if (confirm(`Bạn có chắc chắn muốn ${action} đăng ký này?`)) {
                fetch(`/Admin/Registrations?handler=UpdateStatus`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({ registrationId, status })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                    }
                });
            }
        }

        function checkIn(registrationId) {
            document.getElementById('registrationId').value = registrationId;
            document.getElementById('checkInMethod').value = 'Manual';
            document.getElementById('checkInLocation').value = '';
            checkInModal.show();
        }

        function submitCheckIn() {
            const registrationId = document.getElementById('registrationId').value;
            const checkInMethod = document.getElementById('checkInMethod').value;
            const checkInLocation = document.getElementById('checkInLocation').value;

            if (!checkInLocation) {
                alert('Vui lòng nhập địa điểm check-in.');
                return;
            }

            fetch(`/Admin/Registrations?handler=CheckIn`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ registrationId, checkInMethod, checkInLocation })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    checkInModal.hide();
                    location.reload();
                } else {
                    alert(data.message || 'Có lỗi xảy ra. Vui lòng thử lại.');
                }
            });
        }
    </script>
} 