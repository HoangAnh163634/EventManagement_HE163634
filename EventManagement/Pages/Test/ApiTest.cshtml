@page "/test/api"
@model EventManagement.Pages.Test.ApiTestModel
@{
    ViewData["Title"] = "API Test Page";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h2 class="text-gold mb-4">🧪 API Test Center</h2>
        </div>
    </div>

    <!-- JWT Token Display -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h5 class="mb-0">🔑 JWT Token</h5>
                </div>
                <div class="card-body">
                    <textarea id="jwtToken" class="form-control bg-dark text-light border-gold" rows="3" 
                              placeholder="JWT Token sẽ hiển thị ở đây sau khi login thành công..."></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Register Test -->
        <div class="col-md-6 mb-4">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h5 class="mb-0">📝 Test Register API</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-gold">Full Name:</label>
                        <input type="text" id="regFullName" class="form-control bg-dark text-light border-gold" 
                               value="Test User API" placeholder="Enter full name">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Email:</label>
                        <input type="email" id="regEmail" class="form-control bg-dark text-light border-gold" 
                               value="testapi@example.com" placeholder="Enter email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Password:</label>
                        <input type="password" id="regPassword" class="form-control bg-dark text-light border-gold" 
                               value="TestAPI123!" placeholder="Enter password">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Phone:</label>
                        <input type="tel" id="regPhone" class="form-control bg-dark text-light border-gold" 
                               value="0987654321" placeholder="Enter phone">
                    </div>
                    <button onclick="testRegister()" class="btn btn-gold w-100">
                        <i class="fas fa-user-plus"></i> Test Register
                    </button>
                    <div id="registerResult" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- Login Test -->
        <div class="col-md-6 mb-4">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h5 class="mb-0">🔐 Test Login API</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-gold">Email:</label>
                        <input type="email" id="loginEmail" class="form-control bg-dark text-light border-gold" 
                               value="testapi@example.com" placeholder="Enter email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Password:</label>
                        <input type="password" id="loginPassword" class="form-control bg-dark text-light border-gold" 
                               value="TestAPI123!" placeholder="Enter password">
                    </div>
                    <button onclick="testLogin()" class="btn btn-gold w-100">
                        <i class="fas fa-sign-in-alt"></i> Test Login
                    </button>
                    <div id="loginResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Profile Test -->
        <div class="col-md-6 mb-4">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h5 class="mb-0">👤 Test Profile API</h5>
                </div>
                <div class="card-body">
                    <p class="text-light">Cần JWT token từ login để test endpoint này</p>
                    <button onclick="testProfile()" class="btn btn-gold w-100">
                        <i class="fas fa-user"></i> Get Profile
                    </button>
                    <div id="profileResult" class="mt-3"></div>
                </div>
            </div>
        </div>

        <!-- Email Test -->
        <div class="col-md-6 mb-4">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h5 class="mb-0">📧 Test Email API</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-gold">To Email:</label>
                        <input type="email" id="emailTo" class="form-control bg-dark text-light border-gold" 
                               value="test@example.com" placeholder="Enter recipient email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Subject:</label>
                        <input type="text" id="emailSubject" class="form-control bg-dark text-light border-gold" 
                               value="🧪 Test Email from API" placeholder="Enter subject">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-gold">Body:</label>
                        <textarea id="emailBody" class="form-control bg-dark text-light border-gold" rows="3"
                                  placeholder="Enter email body">Đây là email test từ EventManagement API! 🎉</textarea>
                    </div>
                    <button onclick="testEmail()" class="btn btn-gold w-100">
                        <i class="fas fa-envelope"></i> Send Test Email
                    </button>
                    <div id="emailResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentJwtToken = '';

async function testRegister() {
    const resultDiv = document.getElementById('registerResult');
    resultDiv.innerHTML = '<div class="text-info"><i class="fas fa-spinner fa-spin"></i> Registering...</div>';
    
    try {
        const response = await fetch('/api/auth/register', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                fullName: document.getElementById('regFullName').value,
                email: document.getElementById('regEmail').value,
                password: document.getElementById('regPassword').value,
                phoneNumber: document.getElementById('regPhone').value
            })
        });
        
        const data = await response.json();
        
        if (response.ok) {
            resultDiv.innerHTML = `<div class="alert alert-success">
                <i class="fas fa-check-circle"></i> Registration successful!<br>
                <small>User ID: ${data.userId}</small>
            </div>`;
        } else {
            resultDiv.innerHTML = `<div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> ${data.message}
            </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">
            <i class="fas fa-times-circle"></i> Error: ${error.message}
        </div>`;
    }
}

async function testLogin() {
    const resultDiv = document.getElementById('loginResult');
    resultDiv.innerHTML = '<div class="text-info"><i class="fas fa-spinner fa-spin"></i> Logging in...</div>';
    
    try {
        const response = await fetch('/api/auth/login', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                email: document.getElementById('loginEmail').value,
                password: document.getElementById('loginPassword').value
            })
        });
        
        const data = await response.json();
        
        if (response.ok) {
            currentJwtToken = data.token;
            document.getElementById('jwtToken').value = currentJwtToken;
            
            resultDiv.innerHTML = `<div class="alert alert-success">
                <i class="fas fa-check-circle"></i> Login successful!<br>
                <small><strong>User:</strong> ${data.user.fullName}<br>
                <strong>Role:</strong> ${data.user.role}<br>
                <strong>Expires:</strong> ${new Date(data.expiresAt).toLocaleString()}</small>
            </div>`;
        } else {
            resultDiv.innerHTML = `<div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> ${data.message}
            </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">
            <i class="fas fa-times-circle"></i> Error: ${error.message}
        </div>`;
    }
}

async function testProfile() {
    const resultDiv = document.getElementById('profileResult');
    
    if (!currentJwtToken) {
        resultDiv.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Please login first to get JWT token!</div>';
        return;
    }
    
    resultDiv.innerHTML = '<div class="text-info"><i class="fas fa-spinner fa-spin"></i> Getting profile...</div>';
    
    try {
        const response = await fetch('/api/auth/profile', {
            method: 'GET',
            headers: {
                'Authorization': `Bearer ${currentJwtToken}`,
                'Content-Type': 'application/json'
            }
        });
        
        const data = await response.json();
        
        if (response.ok) {
            resultDiv.innerHTML = `<div class="alert alert-success">
                <i class="fas fa-user-check"></i> Profile loaded!<br>
                <small><strong>ID:</strong> ${data.userId}<br>
                <strong>Name:</strong> ${data.fullName}<br>
                <strong>Email:</strong> ${data.email}<br>
                <strong>Role:</strong> ${data.role}<br>
                <strong>Phone:</strong> ${data.phoneNumber || 'N/A'}<br>
                <strong>Created:</strong> ${new Date(data.createdAt).toLocaleString()}<br>
                <strong>Last Login:</strong> ${data.lastLoginAt ? new Date(data.lastLoginAt).toLocaleString() : 'N/A'}</small>
            </div>`;
        } else {
            resultDiv.innerHTML = `<div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> ${data.message}
            </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">
            <i class="fas fa-times-circle"></i> Error: ${error.message}
        </div>`;
    }
}

async function testEmail() {
    const resultDiv = document.getElementById('emailResult');
    
    if (!currentJwtToken) {
        resultDiv.innerHTML = '<div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> Please login first to get JWT token!</div>';
        return;
    }
    
    resultDiv.innerHTML = '<div class="text-info"><i class="fas fa-spinner fa-spin"></i> Sending email...</div>';
    
    try {
        const response = await fetch('/api/auth/test-email', {
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${currentJwtToken}`,
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                toEmail: document.getElementById('emailTo').value,
                subject: document.getElementById('emailSubject').value,
                body: document.getElementById('emailBody').value
            })
        });
        
        const data = await response.json();
        
        if (response.ok) {
            resultDiv.innerHTML = `<div class="alert alert-${data.success ? 'success' : 'warning'}">
                <i class="fas fa-${data.success ? 'check-circle' : 'exclamation-triangle'}"></i> ${data.message}
            </div>`;
        } else {
            resultDiv.innerHTML = `<div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> ${data.message}
            </div>`;
        }
    } catch (error) {
        resultDiv.innerHTML = `<div class="alert alert-danger">
            <i class="fas fa-times-circle"></i> Error: ${error.message}
        </div>`;
    }
}
</script> 