@page
@model EventManagement.Pages.Staff.NotificationsModel
@{
    ViewData["Title"] = "Thông báo (Staff)";
    Layout = "../Shared/_Layout.cshtml";
}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            @await Html.PartialAsync("../Shared/Partials/_StaffSidebar")
        </div>
        <div class="col-lg-9">
            <div class="card bg-dark border-gold mb-4">
                <div class="card-header bg-gold text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-bell me-2"></i>Thông báo
                    </h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Tiêu đề</th>
                                    <th>Nội dung</th>
                                    <th>Thời gian</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var noti in Model.Notifications)
                                {
                                    <tr>
                                        <td>@noti.Title</td>
                                        <td>@noti.Body</td>
                                        <td>@noti.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            @if (noti.IsRead)
                                            {
                                                <span class="badge bg-success">Đã đọc</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Chưa đọc</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Pagination">
                            <ul class="pagination justify-content-center mt-3">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="?Page=@(Model.CurrentPage - 1)">&laquo;</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?Page=@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?Page=@(Model.CurrentPage + 1)">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 