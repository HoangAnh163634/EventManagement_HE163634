@page
@model EventManagement.Pages.Staff.EventsModel
@{
    ViewData["Title"] = "Sự kiện (Staff)";
    Layout = "../Shared/_Layout.cshtml";
}
<div class="container py-5">
    <div class="row">
        <div class="col-lg-3">
            @await Html.PartialAsync("../Shared/Partials/_StaffSidebar")
        </div>
        <div class="col-lg-9">
            <div class="card bg-dark border-gold mb-4">
                <div class="card-header bg-gold text-dark">
                    <h4 class="mb-0">
                        <i class="fas fa-calendar-alt me-2"></i>Danh sách sự kiện
                    </h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Tên sự kiện</th>
                                    <th>Thời gian</th>
                                    <th>Địa điểm</th>
                                    <th>Đăng ký</th>
                                    <th>Check-in</th>
                                    <th>Feedback</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var evt in Model.Events)
                                {
                                    <tr>
                                        <td>@evt.EventName</td>
                                        <td>@evt.StartDate.ToString("dd/MM/yyyy HH:mm")<br />- @evt.EndDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@evt.Location</td>
                                        <td>@evt.Registrations.Count()</td>
                                        <td>@evt.Registrations.Count(r => r.Status == "CheckedIn")</td>
                                        <td>@evt.Feedbacks.Count()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.TotalPages > 1)
                    {
                        <nav aria-label="Pagination">
                            <ul class="pagination justify-content-center mt-3">
                                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="?Page=@(Model.CurrentPage - 1)">&laquo;</a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?Page=@i">@i</a>
                                    </li>
                                }
                                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="?Page=@(Model.CurrentPage + 1)">&raquo;</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        </div>
    </div>
</div> 