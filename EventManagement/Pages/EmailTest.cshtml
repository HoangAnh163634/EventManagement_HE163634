@page "/email-test"
@model EventManagement.Pages.EmailTestModel

<div class="container mt-4">
    <div class="card bg-dark border-gold">
        <div class="card-header bg-gold text-dark">
            <h5>📧 Quick Email Test</h5>
        </div>
        <div class="card-body">
            <form method="post">
                <input asp-for="ToEmail" placeholder="Your email" class="form-control mb-3" value="anhminhccc1311@gmail.com" />
                <button type="submit" class="btn btn-gold">Send Test Email</button>
            </form>
            @if(ViewData["Result"] != null) {
                <div class="alert alert-info mt-3">@ViewData["Result"]</div>
            }
        </div>
    </div>
</div> 