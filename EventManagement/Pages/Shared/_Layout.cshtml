
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Event Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EventManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
    <style>
        /* Custom styles for verification banner */
        .verification-banner {
            background-color: #fff3cd;
            color: #856404;
            border-color: #ffeeba;
            padding: 0.75rem 1.25rem;
            position: sticky;
            top: 56px;
            z-index: 1040;
            text-align: center;
            margin-bottom: 0;
            font-weight: 500;
        }
        .verification-banner a.btn-gold {
            color: #000;
            background-color: #ffc107;
            border-color: #ffc107;
            padding: 0.25rem 0.5rem;
            font-size: 0.875rem;
            line-height: 1.5;
            border-radius: 0.2rem;
            text-decoration: none;
            margin-left: 0.5rem;
        }
        .verification-banner a.btn-gold:hover {
            background-color: #e0a800;
            border-color: #d39e00;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100 bg-black text-white">
    <partial name="Partials/_Header" />

    @if (Context.Session.GetString("UserRole") == "Staff")
    {
        <partial name="~/Pages/Shared/Partials/_StaffSidebar.cshtml" />
    }
    else if (Context.Session.GetString("UserRole") == "Admin")
    {
        <partial name="~/Pages/Shared/Partials/_AdminSidebar.cshtml" />
    }

    <!-- Custom Verification Banner - Completely separate from Bootstrap alerts -->
    @if (Context.Session.GetInt32("UserId") != null && Context.Session.GetString("UserEmailVerified") == "false")
    {
        <div class="verification-banner">
            <strong>⚠️ Tài khoản của bạn chưa xác thực email!</strong> 
            Vui lòng kiểm tra email và xác thực để sử dụng đầy đủ chức năng.
            <a href="/Account/ResendVerification" class="btn-gold">Gửi lại email xác thực</a>
        </div>
    }

    <main role="main" class="flex-grow-1">
        <!-- Temporary Alerts Container -->
        <div id="temporaryAlerts">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["InfoMessage"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show m-3" role="alert">
                    <i class="fas fa-info-circle me-2"></i>@TempData["InfoMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        @RenderBody()
    </main>

    <partial name="Partials/_Footer" />

    <!-- Notification Toast -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="notificationToast" class="toast bg-dark border-gold" role="alert">
            <div class="toast-header bg-dark text-white border-gold">
                <i class="fas fa-bell text-gold me-2"></i>
                <strong class="me-auto" id="notificationTitle"></strong>
                <small class="text-muted" id="notificationTime"></small>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body text-white" id="notificationBody">
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@3.2.12/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.0/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle dropdown function
        function toggleDropdown(event) {
            event.preventDefault();
            event.stopPropagation();
            
            var dropdownMenu = document.getElementById('userDropdownMenu');
            var dropdownToggle = document.getElementById('navbarDropdown');
            
            if (dropdownMenu.classList.contains('show')) {
                dropdownMenu.classList.remove('show');
                dropdownToggle.setAttribute('aria-expanded', 'false');
            } else {
                dropdownMenu.classList.add('show');
                dropdownToggle.setAttribute('aria-expanded', 'true');
            }
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            var dropdown = document.querySelector('.dropdown');
            var dropdownMenu = document.getElementById('userDropdownMenu');
            
            if (dropdown && !dropdown.contains(event.target)) {
                dropdownMenu.classList.remove('show');
                document.getElementById('navbarDropdown').setAttribute('aria-expanded', 'false');
            }
        });

        // Auto-dismiss only temporary alerts
        document.addEventListener('DOMContentLoaded', function() {
            var temporaryAlerts = document.getElementById('temporaryAlerts');
            if (temporaryAlerts) {
                setTimeout(function() {
                    var alerts = temporaryAlerts.querySelectorAll('.alert');
                    alerts.forEach(function(alert) {
                        alert.style.opacity = '0';
                        alert.style.transition = 'opacity 0.5s ease';
                        setTimeout(function() {
                            alert.remove();
                        }, 500);
                    });
                }, 5000);
            }
        });

        // Connect to SignalR hub
        const userId = '@Context.Session.GetInt32("UserId")';
        if (userId) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notificationHub")
                .withAutomaticReconnect()
                .build();

            connection.start()
                .then(() => connection.invoke("JoinUserGroup", userId))
                .catch(err => console.error(err));

            connection.on("ReceiveNotification", notification => {
                // Update notification count
                const countElement = document.getElementById('notificationCount');
                if (countElement) {
                    const count = parseInt(countElement.textContent) + 1;
                    countElement.textContent = count;
                    countElement.style.display = 'inline';
                }

                // Show toast
                const toast = new bootstrap.Toast(document.getElementById('notificationToast'));
                document.getElementById('notificationTitle').textContent = notification.title;
                document.getElementById('notificationBody').textContent = notification.body;
                document.getElementById('notificationTime').textContent = 'Vừa xong';
                toast.show();
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
