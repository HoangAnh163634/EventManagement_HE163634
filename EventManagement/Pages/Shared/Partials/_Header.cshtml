@using EventManagement.Services
@inject NotificationService NotificationService
@{
    var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var unreadCount = 0;
    if (!string.IsNullOrEmpty(userId))
    {
        unreadCount = await NotificationService.GetUnreadNotificationCount(userId);
    }
}

<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
        <div class="container">
            <a class="navbar-brand text-gold" href="/">Event Management</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/">
                            <i class="fas fa-home me-1"></i>Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-white" href="/Events">
                            <i class="fas fa-calendar-alt me-1"></i>Sự kiện
                        </a>
                    </li>

                    
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        var userName = Context.Session.GetString("UserName") ?? "User";
                        var userRole = Context.Session.GetString("UserRole") ?? "Attendee";
                        
                        @if ((userRole == "Admin" || userRole == "Organizer") && Context.Session.GetString("UserEmailVerified") == "true")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" href="/Events/Create">
                                    <i class="fas fa-plus-circle me-1"></i>Tạo sự kiện
                                </a>
                            </li>
                        }
                        else if ((userRole == "Admin" || userRole == "Organizer") && Context.Session.GetString("UserEmailVerified") == "false")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-secondary disabled" tabindex="-1" aria-disabled="true" title="Bạn cần xác thực email để tạo sự kiện">
                                    <i class="fas fa-plus-circle me-1"></i>Tạo sự kiện (Cần xác thực email)
                                </a>
                            </li>
                        }

                        @if (Context.Session.GetString("UserRole") == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-gold" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-1"></i>Bảng điều khiển</a>
                            </li>
                        }

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-gold" href="/Events/MyEvents"><i class="fas fa-calendar-check me-1"></i>Sự kiện của tôi</a>
                            </li>
                        }

                        <!-- Notifications -->
                        <li class="nav-item me-2">
                            <a class="nav-link text-white position-relative" href="/Notifications">
                                <i class="fas fa-bell"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="badge bg-danger">@unreadCount</span>
                                }
                            </a>
                        </li>
                        
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-gold" href="#" id="navbarDropdown" role="button" onclick="toggleDropdown(event)" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>@userName
                            </a>
                            <div class="dropdown-menu dropdown-menu-end bg-dark border-gold" aria-labelledby="userDropdown">
                                <a class="dropdown-item text-white" href="/Events/MyRegistrations">
                                    <i class="fas fa-ticket-alt me-2"></i>Sự kiện đã đăng ký
                                </a>
                                <a class="dropdown-item text-white" href="/Events/MyFeedback">
                                    <i class="fas fa-star me-2"></i>Đánh giá của tôi
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Organizer"))
                                {
                                    <a class="dropdown-item text-white" href="/Events/MyEvents">
                                        <i class="fas fa-calendar-alt me-2"></i>Sự kiện của tôi
                                    </a>
                                }
                                <div class="dropdown-divider border-secondary"></div>
                                <a class="dropdown-item text-white" href="/Account/Profile">
                                    <i class="fas fa-user me-2"></i>Thông tin cá nhân
                                </a>
                                <form method="post" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index")">
                                    <button type="submit" class="dropdown-item text-white">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Account/Login">
                                <i class="fas fa-sign-in-alt me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn btn-outline-gold ms-2 px-3" href="/Account/Register">
                                <i class="fas fa-user-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>
