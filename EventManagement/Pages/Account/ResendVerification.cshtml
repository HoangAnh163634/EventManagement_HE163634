@page
@model EventManagement.Pages.Account.ResendVerificationModel
@{
    ViewData["Title"] = "Gửi lại email xác thực";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card bg-dark border-gold">
                <div class="card-header bg-gold text-dark">
                    <h4 class="mb-0">Gửi lại email xác thực</h4>
                </div>
                <div class="card-body">
                    @if (Model.Message != null)
                    {
                        <div class="alert alert-info">@Model.Message</div>
                    }
                    <a href="/" class="btn btn-gold">Về trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div> 