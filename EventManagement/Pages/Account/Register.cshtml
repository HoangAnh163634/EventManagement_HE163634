@page
@model EventManagement.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card bg-gray-dark shadow-lg">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="text-gold mb-1">Create Account</h2>
                        <p class="text-muted">Join our event community</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label asp-for="Input.FullName" class="form-label text-white">
                                    Full Name <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.FullName" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Enter your full name" autocomplete="name" />
                                <span asp-validation-for="Input.FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Email" class="form-label text-white">
                                    Email Address <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Email" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Enter your email" autocomplete="username" />
                                <span asp-validation-for="Input.Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.PhoneNumber" class="form-label text-white">
                                    Phone Number
                                </label>
                                <input asp-for="Input.PhoneNumber" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Enter your phone number" autocomplete="tel" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Password" class="form-label text-white">
                                    Password <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.Password" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Create a strong password" autocomplete="new-password" />
                                <span asp-validation-for="Input.Password" class="text-danger"></span>
                                <small class="text-muted">
                                    Must contain: 8+ characters, uppercase, lowercase, number, special character
                                </small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.ConfirmPassword" class="form-label text-white">
                                    Confirm Password <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Input.ConfirmPassword" class="form-control bg-dark text-white border-secondary" 
                                       placeholder="Confirm your password" autocomplete="new-password" />
                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Input.AgreeToTerms" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.AgreeToTerms" class="form-check-label text-white">
                                I agree to the <a href="#" class="text-gold">Terms and Conditions</a> and 
                                <a href="#" class="text-gold">Privacy Policy</a> <span class="text-danger">*</span>
                            </label>
                            <span asp-validation-for="Input.AgreeToTerms" class="text-danger d-block"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" id="submitButton" class="btn btn-custom-gold btn-lg" disabled>
                                <i class="fas fa-user-plus me-2"></i>Create Account
                            </button>
                            <small class="text-muted text-center mt-2" id="submitHelp">
                                Please fill all required fields correctly to continue
                            </small>
                        </div>
                    </form>

                    <hr class="my-4" style="border-color: #2F2F2F;">
                    
                    <div class="text-center">
                        <p class="text-muted mb-2">Already have an account?</p>
                        <a href="/Account/Login" class="btn btn-outline-gold">
                            <i class="fas fa-sign-in-alt me-2"></i>Sign In
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register-validation.js" asp-append-version="true"></script>
} 