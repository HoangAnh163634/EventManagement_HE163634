@page
@model EventManagement.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="text-gold mb-4">
                <i class="fas fa-user me-2"></i>Thông tin cá nhân
            </h2>

            <div class="card bg-dark border-gold">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="CurrentUser.FullName" class="form-label text-white">Họ và tên</label>
                            <input asp-for="CurrentUser.FullName" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="CurrentUser.FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrentUser.Email" class="form-label text-white">Email</label>
                            <input asp-for="CurrentUser.Email" class="form-control bg-dark text-white border-secondary" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="CurrentUser.PhoneNumber" class="form-label text-white">Số điện thoại</label>
                            <input asp-for="CurrentUser.PhoneNumber" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="CurrentUser.PhoneNumber" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark border-gold mb-4">
                <div class="card-body text-center">
                    <h5 class="text-gold mb-4">Ảnh đại diện</h5>
                    <img src="@(Model.CurrentUser.ProfileImageUrl ?? "/images/default-avatar.png")" alt="Avatar" class="rounded-circle mb-3" style="width: 120px; height: 120px; object-fit: cover; border: 2px solid #FFD700;">
                    <form method="post" enctype="multipart/form-data">
                        <div class="mb-3">
                            <input type="file" name="AvatarUpload" accept="image/*" class="form-control bg-dark text-white border-secondary" />
                        </div>
                        <button type="submit" class="btn btn-outline-gold w-100 mb-2">
                            <i class="fas fa-upload me-2"></i>Cập nhật ảnh đại diện
                        </button>
                    </form>
                </div>
            </div>
            <div class="card bg-dark border-gold mb-4">
                <div class="card-body">
                    <h5 class="text-gold mb-4">Thông tin tài khoản</h5>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge bg-success">Đang hoạt động</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Ngày tham gia:</span>
                        <span class="text-white">@Model.CurrentUser.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Vai trò:</span>
                        <span class="text-white">@string.Join(", ", Model.UserRoles)</span>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-gold">
                <div class="card-body">
                    <h5 class="text-gold mb-4">Đổi mật khẩu</h5>
                    <form method="post" asp-page-handler="ChangePassword">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label text-white">Mật khẩu hiện tại</label>
                            <input type="password" id="currentPassword" name="currentPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label text-white">Mật khẩu mới</label>
                            <input type="password" id="newPassword" name="newPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label text-white">Xác nhận mật khẩu mới</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <button type="submit" class="btn btn-outline-gold">
                            <i class="fas fa-key me-2"></i>Đổi mật khẩu
                        </button>
                    </form>
                </div>
            </div>

            @{
                var myEvents = Model.RegisteredEvents ?? new List<EventManagement.Models.Event>();
            }
            @if (Model.CurrentUser.CalendarSyncs == null || !Model.CurrentUser.CalendarSyncs.Any(s => s.Provider == "Google" && s.IsActive))
            {
                <form method="get" asp-page-handler="ConnectGoogleCalendar">
                    <div class="mb-2">
                        <label for="eventId" class="form-label">Chọn sự kiện để đồng bộ với Google Calendar:</label>
                        <select id="eventId" class="form-select" required>
                            <option value="">-- Chọn sự kiện --</option>
                            @foreach (var evt in myEvents)
                            {
                                <option value="@evt.EventId">@evt.EventName (@evt.StartDate.ToString("dd/MM/yyyy"))</option>
                            }
                        </select>
                    </div>
                    <a id="connectGoogleBtn" href="#" class="btn btn-outline-danger" onclick="connectGoogleCalendar(event)">
                        <i class="fab fa-google me-1"></i>Kết nối Google Calendar
                    </a>
                    <script>
                        function connectGoogleCalendar(e) {
                            e.preventDefault();
                            var eventId = document.getElementById('eventId').value;
                            if (!eventId) {
                                alert('Vui lòng chọn sự kiện!');
                                return;
                            }
                            window.location.href = '?handler=ConnectGoogleCalendar&eventId=' + eventId;
                        }
                    </script>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 