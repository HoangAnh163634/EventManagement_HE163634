@page
@model EventManagement.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-8">
            <h2 class="text-gold mb-4">
                <i class="fas fa-user me-2"></i>Thông tin cá nhân
            </h2>

            <div class="card bg-dark border-gold">
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="User.FullName" class="form-label text-white">Họ và tên</label>
                            <input asp-for="User.FullName" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="User.FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.Email" class="form-label text-white">Email</label>
                            <input asp-for="User.Email" class="form-control bg-dark text-white border-secondary" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="User.PhoneNumber" class="form-label text-white">Số điện thoại</label>
                            <input asp-for="User.PhoneNumber" class="form-control bg-dark text-white border-secondary" />
                            <span asp-validation-for="User.PhoneNumber" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-gold">
                            <i class="fas fa-save me-2"></i>Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card bg-dark border-gold mb-4">
                <div class="card-body">
                    <h5 class="text-gold mb-4">Thông tin tài khoản</h5>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Trạng thái:</span>
                        <span class="badge bg-success">Đang hoạt động</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Ngày tham gia:</span>
                        <span class="text-white">@Model.User.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Vai trò:</span>
                        <span class="text-white">@string.Join(", ", Model.UserRoles)</span>
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-gold">
                <div class="card-body">
                    <h5 class="text-gold mb-4">Đổi mật khẩu</h5>
                    <form method="post" asp-page-handler="ChangePassword">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label text-white">Mật khẩu hiện tại</label>
                            <input type="password" id="currentPassword" name="currentPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label text-white">Mật khẩu mới</label>
                            <input type="password" id="newPassword" name="newPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label text-white">Xác nhận mật khẩu mới</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="form-control bg-dark text-white border-secondary" required />
                        </div>
                        <button type="submit" class="btn btn-outline-gold">
                            <i class="fas fa-key me-2"></i>Đổi mật khẩu
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 