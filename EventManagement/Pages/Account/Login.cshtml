@page
@model EventManagement.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card bg-gray-dark shadow-lg">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <h2 class="text-gold mb-1">Welcome Back</h2>
                        <p class="text-muted">Sign in to your account</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <input type="hidden" asp-for="Input.ReturnUrl" />
                        
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label text-white">Email</label>
                            <input asp-for="Input.Email" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Enter your email" autocomplete="username" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label text-white">Password</label>
                            <input asp-for="Input.Password" class="form-control bg-dark text-white border-secondary" 
                                   placeholder="Enter your password" autocomplete="current-password" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-white">
                                Remember me
                            </label>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-custom-gold btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Sign In
                            </button>
                        </div>
                    </form>

                    <hr class="my-4" style="border-color: #2F2F2F;">
                    
                    <div class="text-center">
                        <p class="text-muted mb-2">Don't have an account?</p>
                        <a href="/Account/Register" class="btn btn-outline-gold">
                            <i class="fas fa-user-plus me-2"></i>Create Account
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 