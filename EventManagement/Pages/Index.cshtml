
@page
@model EventManagement.Pages.IndexModel
@{
    ViewData["Title"] = "Event Management";
}

<!-- Hero Section -->
<section class="hero bg-dark text-white py-5" style="background: linear-gradient(to bottom, #1A1A1A, #0F0F0F); position: relative;">
    <div class="container text-center py-5" style="position: relative; z-index: 2;">
        <h1 class="display-4 fw-bold mb-3 hero-text">Lên kế hoạch cho sự kiện hoàn hảo của bạn</h1>
        <p class="lead mb-4">Tạo, quản lý và nâng tầm sự kiện của bạn một cách chuyên nghiệp.</p>
        @if (HttpContext.Session.GetString("UserEmailVerified") == "true")
        {
            <a href="/Events/Create" class="btn btn-custom-gold btn-lg mx-2">Tạo sự kiện</a>
        }
        else if (HttpContext.Session.GetInt32("UserId") != null)
        {
            <a class="btn btn-custom-gold btn-lg mx-2 disabled" tabindex="-1" aria-disabled="true" title="Bạn cần xác thực email để tạo sự kiện">Tạo sự kiện (Cần xác thực email)</a>
        }
        <a href="/Events" class="btn btn-outline-light btn-lg mx-2">Khám phá sự kiện</a>
    </div>
    <div class="parallax-overlay"></div>
</section>

<!-- Latest Events Section -->
<section id="events" class="py-5 bg-black">
    <div class="container">
        <h2 class="text-center mb-4 text-white">Sự kiện mới nhất</h2>
        <div class="row">
            @if (Model.Events.Any())
            {
                @foreach (var evt in Model.Events.Take(3))
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 shadow-lg bg-dark text-white event-card">
                            <img src="https://picsum.photos/300/200?random=@evt.EventId" class="card-img-top" alt="@evt.EventName">
                            <div class="card-body">
                                <h5 class="card-title">@evt.EventName</h5>
                                <p class="card-text">
                                    <i class="fas fa-calendar-alt me-2 text-gold"></i>
                                    <span class="event-date">@evt.StartDate.ToString("MMM dd, yyyy HH:mm")</span>
                                </p>
                                <p class="card-text">
                                    <i class="fas fa-map-marker-alt me-2 text-gold"></i>@evt.Location
                                </p>
                                <p class="card-text">
                                    <i class="fas fa-user me-2 text-gold"></i>Người tổ chức: @evt.Organizer.FullName
                                </p>
                                @if (evt.Price.HasValue && evt.Price > 0)
                                {
                                    <p class="card-text">
                                        <i class="fas fa-tag me-2 text-gold"></i>@evt.Price.Value.ToString("C") @evt.Currency
                                    </p>
                                }
                                else
                                {
                                    <p class="card-text">
                                        <i class="fas fa-gift me-2 text-gold"></i>Miễn phí
                                    </p>
                                }
                            </div>
                            <div class="card-footer text-center bg-dark">
                                <a href="/Events/Details/@evt.EventId" class="btn btn-outline-gold">Chi tiết</a>
                                @if (HttpContext.Session.GetString("UserEmailVerified") == "true")
                                {
                                    <a href="/Registrations/Create?eventId=@evt.EventId" class="btn btn-gold">Đăng ký</a>
                                }
                                else if (HttpContext.Session.GetInt32("UserId") != null)
                                {
                                    <a class="btn btn-gold disabled" tabindex="-1" aria-disabled="true" title="Bạn cần xác thực email để đăng ký">Đăng ký (Cần xác thực email)</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="text-center py-5">
                        <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                        <h4 class="text-white mb-3">Chưa có sự kiện nào</h4>
                        <p class="text-muted mb-4">Hiện tại chưa có sự kiện nào sắp diễn ra.</p>
                        <a href="/Events/Create" class="btn btn-custom-gold">
                            <i class="fas fa-plus-circle me-2"></i>Tạo sự kiện đầu tiên
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Automate Your Events Section -->
<section class="py-5 bg-dark">
    <div class="container text-center">
        <h2 class="text-white mb-5">Tự động hóa sự kiện của bạn</h2>
        <p class="lead text-muted mb-4">Đơn giản hóa việc tổ chức sự kiện với các công cụ tự động mạnh mẽ.</p>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card h-100 bg-gray-dark shadow-lg text-white p-4">
                    <i class="fas fa-paint-brush fa-3x mb-3"></i>
                    <h4>Tùy biến</h4>
                    <p>Cá nhân hóa thư mời và đăng ký theo phong cách của bạn.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 bg-gray-dark shadow-lg text-white p-4">
                    <i class="fas fa-sliders-h fa-3x mb-3"></i>
                    <h4>Kiểm soát</h4>
                    <p>Quản lý sự kiện với RSVP nhiều phần và các tuỳ chọn linh hoạt.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 bg-gray-dark shadow-lg text-white p-4">
                    <i class="fas fa-robot fa-3x mb-3"></i>
                    <h4>Tự động hóa</h4>
                    <p>Tự động hóa lập kế hoạch, liên lạc và báo cáo.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Keep the Spotlight Section -->
<section class="py-5 bg-black">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h2 class="text-white mb-4">Giữ sự chú ý cho sự kiện và thương hiệu của bạn</h2>
                <p class="lead text-muted">Khác với các nền tảng khác, chúng tôi tập trung vào trải nghiệm thương hiệu liền mạch, gây ấn tượng với khách mời mà không rườm rà.</p>
            </div>
            <div class="col-md-6">
                <div class="carousel slide" id="spotlightCarousel" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://picsum.photos/300/200?random=1" class="d-block w-100" alt="Event Spotlight">
                        </div>
                        <div class="carousel-item">
                            <img src="https://picsum.photos/300/200?random=2" class="d-block w-100" alt="Event Spotlight">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#spotlightCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#spotlightCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- The Tools and Features Section -->
<section class="py-5 bg-dark">
    <div class="container text-center">
        <h2 class="text-white mb-5">Công cụ và tính năng bạn cần</h2>
        <div class="row g-4 tool-grid">
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Send personalized email invitations to your guests.">
                    <i class="fas fa-envelope fa-2x mb-3"></i>
                    <h5>Gửi thư mời qua email</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Manage online registrations and RSVP responses efficiently.">
                    <i class="fas fa-check-circle fa-2x mb-3"></i>
                    <h5>Đăng ký trực tuyến & xác nhận tham dự</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Collect custom data with flexible fields for your events.">
                    <i class="fas fa-plus fa-2x mb-3"></i>
                    <h5>Thu thập dữ liệu tuỳ chỉnh</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Organize and manage your guest lists with ease.">
                    <i class="fas fa-users fa-2x mb-3"></i>
                    <h5>Quản lý danh sách khách mời</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Sync events with your calendar for better planning.">
                    <i class="fas fa-calendar-alt fa-2x mb-3"></i>
                    <h5>Đồng bộ lịch</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Use QR codes for fast and secure check-in.">
                    <i class="fas fa-qrcode fa-2x mb-3"></i>
                    <h5>Check-in bằng QR</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Ensure event privacy with advanced security settings.">
                    <i class="fas fa-lock fa-2x mb-3"></i>
                    <h5>Bảo mật sự kiện</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Receive real-time notifications for event updates.">
                    <i class="fas fa-bell fa-2x mb-3"></i>
                    <h5>Thông báo</h5>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 bg-gray-light shadow-lg p-4 tool-card" data-content="Generate detailed feedback reports from attendees.">
                    <i class="fas fa-chart-pie fa-2x mb-3"></i>
                    <h5>Báo cáo phản hồi</h5>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- User Reviews Section -->
<section class="py-5 bg-black">
    <div class="container">
        <h2 class="text-center mb-5 text-white">Đánh giá của người dùng</h2>
        <div class="carousel slide" id="reviewCarousel" data-bs-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="row justify-content-center">
                        <div class="col-md-5 mb-4 me-3">
                            <div class="card bg-dark text-white shadow-lg p-4 review-card">
                                <div class="d-flex align-items-center">
                                    <img src="https://picsum.photos/50/50?random=1" class="rounded-circle me-3" alt="Reviewer">
                                    <div>
                                        <p class="card-text">"RSVPify giúp tôi không còn phải vất vả xác nhận sự tham dự. Việc kết nối với nhân viên và nhập thông tin liên hệ trở nên đơn giản hơn rất nhiều."</p>
                                        <h6 class="card-subtitle mb-2 text-gold">- Ashley N.</h6>
                                        <p class="text-muted">Chuyên viên nhân sự</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5 mb-4">
                            <div class="card bg-dark text-white shadow-lg p-4 review-card">
                                <div class="d-flex align-items-center">
                                    <img src="https://picsum.photos/50/50?random=2" class="rounded-circle me-3" alt="Reviewer">
                                    <div>
                                        <p class="card-text">"Tôi đã dùng RSVPify cho tiệc Giáng sinh. Nhờ phần mềm này, chúng tôi tổ chức picnic ngoài trời rất thuận lợi dù có nhiều hạn chế vì COVID."</p>
                                        <h6 class="card-subtitle mb-2 text-gold">- Rebecca R.</h6>
                                        <p class="text-muted">Quản lý hành chính cấp cao</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="row justify-content-center">
                        <div class="col-md-5 mb-4 me-3">
                            <div class="card bg-dark text-white shadow-lg p-4 review-card">
                                <div class="d-flex align-items-center">
                                    <img src="https://picsum.photos/50/50?random=3" class="rounded-circle me-3" alt="Reviewer">
                                    <div>
                                        <p class="card-text">"Check-in QR và thông báo giúp sự kiện của chúng tôi diễn ra suôn sẻ. Rất đáng để sử dụng!"</p>
                                        <h6 class="card-subtitle mb-2 text-gold">- Michael J.</h6>
                                        <p class="text-muted">Điều phối viên sự kiện</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#reviewCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#reviewCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            </div>
        </div>
    </div>
</section>

<!-- Privacy Section -->
<section class="py-5 bg-black">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6 mb-4">
                <img src="https://picsum.photos/500/350?random=4" class="img-fluid" alt="Privacy Image">
            </div>
            <div class="col-md-4 mb-4">
                <h2 class="text-white mb-4">Bảo mật là cốt lõi của chúng tôi</h2>
                <p class="lead text-muted">Chúng tôi đảm bảo dữ liệu sự kiện và thông tin khách mời của bạn luôn an toàn với công nghệ mã hóa tiên tiến.</p>
            </div>
        </div>
    </div>
</section>

<!-- Call-to-Action Section -->
<section class="py-5 bg-dark text-center">
    <div class="container">
        <h2 class="text-white mb-4">Sẵn sàng bắt đầu?</h2>
        <a href="/Events/Create" class="btn btn-gold btn-lg">Bắt đầu ngay</a>
    </div>
</section>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}
